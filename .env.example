APP_ENV=dev
PROD=false
HOST=0.0.0.0
PORT=3000
PUBLIC_PATH=public

# PostgreSQL (`docker compose up -d postgres` publishes it on 127.0.0.1:5434)
DATABASE_URL=postgresql://viggo:viggo-dev-password@127.0.0.1:5434/viggo_administrativo
DATABASE_POOL_MAX=10

JWT_SEED=replace-with-a-long-random-secret
INSTALLATION_LINK_TOKEN_SECRET=replace-with-an-independent-long-random-secret
AUTH_COOKIE_NAME=viggo_admin_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_MS=172800000
# Proteccion contra fuerza bruta en login: solo cuentan los intentos fallidos.
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=20
# Detras de un proxy (nginx, load balancer): numero de saltos de confianza, p. ej. 1.
TRUST_PROXY=false

WEB_SERVICE_URL=http://localhost:3000
WEB_CLIENT_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3004,http://127.0.0.1:3004

MAILER_EMAIL=
MAILER_SECRET_KEY=
MAILER_SERVICE=
MAILER_HOST=
MAILER_PORT=465
MAILER_SECURE=true
MAILER_FROM_NAME=Viggo

SECRET_STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn
STRIPE_ENABLED=false
STRIPE_MOCK_ENABLED=true


# Push notices of installations offline / back online (REFACTO#65).
# Generate the pair once with: npx web-push generate-vapid-keys
# Without both keys the notices are off. The public key is not a secret; the private one is.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# mailto: or https URL the push services can contact (default: mailto:MAILER_EMAIL)
WEB_PUSH_SUBJECT=
WEB_PUSH_COOLDOWN_MS=300000

# Data retention in days (docs/retencion.md); 0 never purges that kind of data.
RETENTION_FINANCIAL_DAYS=1825
RETENTION_OPERATIONAL_DAYS=1825
RETENTION_INBOX_DAYS=30
RETENTION_MOBILE_OPERATIONS_DAYS=90
RETENTION_INCIDENTS_DAYS=365
RETENTION_CONNECTION_EVENTS_DAYS=365
RETENTION_PUSH_SUBSCRIPTIONS_DAYS=180
