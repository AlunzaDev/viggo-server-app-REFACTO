APP_ENV=prod
PROD=true
HOST=0.0.0.0
PORT=8080
PUBLIC_PATH=public

WEB_SERVICE_URL=https://your-admin-api.example.com
WEB_CLIENT_URL=https://your-admin-web.example.com
CORS_ALLOWED_ORIGINS=https://your-admin-web.example.com

# DATABASE_URL is set by docker-compose from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
# Set a strong POSTGRES_PASSWORD in the shell or a compose .env file before the first start.
DATABASE_POOL_MAX=10

JWT_SEED=replace-with-a-long-random-secret-at-least-32-chars
INSTALLATION_LINK_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars

AUTH_COOKIE_NAME=viggo_admin_auth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_MAX_AGE_MS=172800000

MAILER_HOST=smtp.example.com
MAILER_PORT=465
MAILER_SECURE=true
MAILER_EMAIL=notifications@example.com
MAILER_SECRET_KEY=replace-with-mailer-secret
MAILER_FROM_NAME=Viggo

SECRET_STRIPE_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=mxn
STRIPE_ENABLED=true
STRIPE_MOCK_ENABLED=false

FINANCIAL_RECONCILIATION_WORKER_ENABLED=true
FINANCIAL_RECONCILIATION_INTERVAL_MINUTES=15
FINANCIAL_RECONCILIATION_BATCH_SIZE=50

# Push notices (REFACTO#65): generate once with `npx web-push generate-vapid-keys`.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com
WEB_PUSH_COOLDOWN_MS=300000

# Data retention in days (docs/retencion.md); 0 never purges that kind of data.
RETENTION_FINANCIAL_DAYS=1825
RETENTION_OPERATIONAL_DAYS=1825
RETENTION_INBOX_DAYS=30
RETENTION_MOBILE_OPERATIONS_DAYS=90
RETENTION_INCIDENTS_DAYS=365
RETENTION_CONNECTION_EVENTS_DAYS=365
RETENTION_PUSH_SUBSCRIPTIONS_DAYS=180
