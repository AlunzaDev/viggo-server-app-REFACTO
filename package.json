{
  "name": "viggo-server-api-administrativo",
  "version": "1.0.1",
  "description": "API administrativa en nube para Viggo",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preflight": "node scripts/preflight.mjs",
    "audit:app-permissions": "tsx scripts/audit-app-permissions.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "check": "prisma generate && tsc --noEmit && tsc -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "smoke:postgres-clients": "node scripts/smoke-postgres-clients.mjs --clients"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "env-var": "^7.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
