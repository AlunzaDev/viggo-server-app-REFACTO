// PostgreSQL schema for ADMINISTRATIVO (cloud).
// The connection URL lives in prisma.config.ts (Prisma 7 no longer reads it from here).
//
// Conventions
// - Model and field names follow the domain entities (Usuario, Proyecto, nombre, ...);
//   tables and columns are snake_case via @@map/@map.
// - Primary keys are UUID v7 (time ordered, good index locality), generated by Prisma.
// - Instants are timestamptz; money is numeric(12,2). Datasources convert to the
//   epoch-millisecond numbers the domain and API use today.
// - Data owned by OPERATIVO (device runtime, heartbeats, inbox events) is a read-only mirror here.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserApp {
  ADMIN_WEB
  OPERATIVE_WEB
  OPERATIVE_MOBILE

  @@map("user_app")
}

enum UserModule {
  cashPayments
  users
  permissionProfiles
  installations
  projects
  modules
  pensions
  pensionPasses
  tickets
  pensionMoves
  payments

  @@map("user_module")
}

enum ModuloTipo {
  ENTRADA
  SALIDA
  POS

  @@map("modulo_tipo")
}

enum SubmoduloTipo {
  QR_SCANNER
  PRINTER
  BARRIER
  CAMERA
  CASH_DRAWER
  CASH_ACCEPTOR
  DISPLAY
  KEYPAD
  OTHER

  @@map("submodulo_tipo")
}

enum RemoteSupportProvider {
  MESHCENTRAL
  RUSTDESK
  VIGGO_REMOTE
  CUSTOM

  @@map("remote_support_provider")
}

enum DeviceConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  REJECTED
  MISMATCH

  @@map("device_connection_status")
}

enum DeviceHeartbeatStatus {
  online
  offline
  pending

  @@map("device_heartbeat_status")
}

enum PensionPassOperationType {
  precontract
  contract
  renew

  @@map("pension_pass_operation_type")
}

enum PaymentType {
  ticket
  pension
  renewal
  external

  @@map("payment_type")
}

enum PaymentStatus {
  succeeded
  pending
  failed
  refunded

  @@map("payment_status")
}

enum ReconciliationStatus {
  pending
  reconciled
  failed

  @@map("reconciliation_status")
}

enum MobileOperationType {
  CREATE_TICKET
  QUOTE_TICKET
  APPLY_TICKET_PAYMENT
  EXIT_TICKET

  @@map("mobile_operation_type")
}

enum MobileOperationStatus {
  pending
  processing
  completed
  failed
  expired
  dead_letter

  @@map("mobile_operation_status")
}

enum InstallationStatus {
  pending
  approved
  rejected

  @@map("installation_status")
}

enum IncidentType {
  INSTALLATION_OFFLINE
  MOBILE_OPERATION_DEAD_LETTER
  FINANCIAL_WORKER_FAILED
  EXTERNAL_PAYMENT_REVIEW

  @@map("incident_type")
}

enum IncidentStatus {
  open
  resolved

  @@map("incident_status")
}

enum IncidentSeverity {
  info
  warning
  critical

  @@map("incident_severity")
}

// ───────────────────────── Identity & access ─────────────────────────

/// Catalog of account types. Code relies on the system roles (sistema = true);
/// what each user can do per app comes from permission_profiles.
model Rol {
  /// Stable code used by the API and tokens, e.g. SUPER_ROLE.
  code        String   @id
  nombre      String
  descripcion String   @default("")
  /// System roles are seeded by migrations and must not be deleted.
  sistema     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id                       String    @id @default(uuid(7)) @db.Uuid
  nombre                   String
  apellido                 String
  /// Stored lowercase.
  correo                   String    @unique
  emailValidated           Boolean   @default(false) @map("email_validated")
  emailValidationTokenHash String?   @map("email_validation_token_hash")
  emailValidationExpiresAt DateTime? @map("email_validation_expires_at") @db.Timestamptz(3)
  telefono                 String    @unique
  /// As sent by the clients (no fixed order or length).
  coordinates              Float[]   @default([])
  /// bcrypt hash.
  password                 String
  passwordResetTokenHash   String?   @map("password_reset_token_hash")
  passwordResetExpiresAt   DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  rol                      String    @default("CLIENT_ROLE")
  allowedApps              UserApp[] @default([]) @map("allowed_apps")
  /// Instant sent by the clients (epoch ms in the API).
  nacimiento               DateTime? @db.Timestamptz(3)
  img                      String    @default("")
  estado                   Boolean   @default(true)
  google                   Boolean   @default(false)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolRef                 Rol                    @relation(fields: [rol], references: [code], onDelete: Restrict)
  parkings               UsuarioParking[]
  appPermissions         UsuarioAppPermission[]
  pensionPasses          PensionPass[]          @relation("PensionPassUsuario")
  cancelledPensionPasses PensionPass[]          @relation("PensionPassCancelledBy")
  cancelledPensiones     Pension[]              @relation("PensionCancelledBy")
  payments               Payment[]
  externalPaymentOrders  ExternalPaymentOrder[]
  mobileOperations       MobileOperation[]
  reviewedInstallations  LocalInstallation[]    @relation("InstallationReviewedBy")

  @@index([rol])
  @@map("usuarios")
}

/// Parkings a user may operate (was Usuario.parkings).
model UsuarioParking {
  usuarioId  String @map("usuario_id") @db.Uuid
  proyectoId String @map("proyecto_id") @db.Uuid

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, proyectoId])
  @@index([proyectoId])
  @@map("usuario_parkings")
}

/// One permission profile per user and app (was Usuario.appPermissions).
model UsuarioAppPermission {
  usuarioId           String  @map("usuario_id") @db.Uuid
  app                 UserApp
  permissionProfileId String  @map("permission_profile_id") @db.Uuid

  usuario           Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permissionProfile PermissionProfile @relation(fields: [permissionProfileId], references: [id], onDelete: Restrict)

  @@id([usuarioId, app])
  @@index([permissionProfileId])
  @@map("usuario_app_permissions")
}

model PermissionProfile {
  id          String       @id @default(uuid(7)) @db.Uuid
  app         UserApp
  nombre      String
  descripcion String       @default("")
  modules     UserModule[] @default([])
  estado      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuarios UsuarioAppPermission[]

  @@unique([app, nombre])
  @@map("permission_profiles")
}

// ───────────────────────── Parkings & modules ─────────────────────────

model Proyecto {
  id                             String    @id @default(uuid(7)) @db.Uuid
  nombre                         String
  /// [lon, lat] or a polygon [[lon, lat], ...].
  coordinates                    Json
  ciudad                         String
  direccion                      String    @default("")
  identificador                  String    @unique
  /// Short human code "0001".."9999", assigned from proyecto_codigo_seq.
  codigoProyecto                 String    @unique @default(dbgenerated("lpad((nextval('proyecto_codigo_seq'::regclass))::text, 4, '0'::text)")) @map("codigo_proyecto") @db.VarChar(4)
  serverIp                       String    @default("") @map("server_ip")
  serverMac                      String    @default("") @map("server_mac")
  localApiBaseUrl                String    @default("") @map("local_api_base_url")
  paymentProvider                String    @default("") @map("payment_provider")
  externalParkingId              String    @default("") @map("external_parking_id")
  paymentProviderId              String?   @map("payment_provider_id") @db.Uuid
  installationLinkTokenHash      String    @default("") @map("installation_link_token_hash")
  /// AES-encrypted so admins can display it again.
  installationLinkTokenEncrypted String    @default("") @map("installation_link_token_encrypted")
  installationLinkTokenIssuedAt  DateTime? @map("installation_link_token_issued_at") @db.Timestamptz(3)
  img                            String    @default("")
  descripcion                    String    @default("")
  estado                         Boolean   @default(true)
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  remoteSupport            ProyectoRemoteSupport?
  paymentProviderRelation  PaymentProvider?          @relation(fields: [paymentProviderId], references: [id], onDelete: SetNull)
  externalPaymentOrders    ExternalPaymentOrder[]
  modulos                  Modulo[]
  pensiones                Pension[]
  usuarios                 UsuarioParking[]
  installations            LocalInstallation[]
  mobileOperations         MobileOperation[]
  payments                 Payment[]
  incidents                OperationalIncident[]
  inboxEvents              InboxEvent[]
  operationalTickets       OperationalTicket[]
  operationalPayments      OperationalPayment[]
  operationalCashSessions  OperationalCashSession[]
  operationalCashShifts    OperationalCashShift[]
  operationalCashMovements OperationalCashMovement[]
  operationalCashCuts      OperationalCashCut[]
  operationalPensionMoves  OperationalPensionMove[]

  heartbeatSnapshot ProjectHeartbeatSnapshot?

  @@index([estado])
  @@index([paymentProviderId])
  /// Linking: an installation presents the link token and the project is found by its hash.
  @@index([installationLinkTokenHash])
  @@map("proyectos")
}

/// How a parking provider charges: Viggo's own ticket flow (OPERATIVO), the Viggo provider
/// API standard (docs/api-proveedores.md) or an adapter coded for one provider.
enum PaymentProviderIntegration {
  viggo
  standard
  adapter

  @@map("payment_provider_integration")
}

model PaymentProvider {
  id                  String                     @id @default(uuid(7)) @db.Uuid
  nombre              String                     @unique
  logo                String                     @default("")
  integration         PaymentProviderIntegration @default(viggo)
  /// Coded extension (integration = adapter) for what a mapping cannot express; empty uses apiMapping.
  adapter             String                     @default("")
  /// Base URL of the provider's API (standard/adapter).
  baseUrl             String                     @default("") @map("base_url")
  /// Credential the provider gave Viggo, encrypted. The API never returns it.
  credentialEncrypted String                     @default("") @map("credential_encrypted")
  /// Header the credential goes in: empty sends `Authorization: Bearer <credential>`;
  /// a name (e.g. X-API-Key) sends the credential as is in that header.
  authHeader          String                     @default("") @map("auth_header")
  /// An inactive provider neither quotes nor charges.
  active              Boolean                    @default(true)
  timeoutMs           Int                        @default(8000) @map("timeout_ms")
  /// How its own API is spoken (integration = adapter): requests and where each datum is in
  /// its answers. See src/domain/entities/parking/provider-api-mapping.ts.
  apiMapping          Json?                      @map("api_mapping")
  /// Last successful connection test; cleared when the connection changes. An external
  /// provider can only be active once tested.
  verifiedAt          DateTime?                  @map("verified_at") @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  proyectos           Proyecto[]

  @@map("payment_providers")
}

model ProyectoRemoteSupport {
  proyectoId String                @id @map("proyecto_id") @db.Uuid
  provider   RemoteSupportProvider @default(MESHCENTRAL)
  enabled    Boolean               @default(false)
  baseUrl    String                @default("") @map("base_url")
  groupId    String                @default("") @map("group_id")
  updatedAt  DateTime?             @map("updated_at") @db.Timestamptz(3)

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("proyecto_remote_support")
}

model Modulo {
  id            String     @id @default(uuid(7)) @db.Uuid
  proyectoId    String     @map("proyecto_id") @db.Uuid
  nombre        String
  tipo          ModuloTipo
  estado        Boolean    @default(true)
  identificador String     @unique
  ip            String     @default("")
  mac           String     @default("")
  ubicacion     String     @default("")
  longitude     Float?
  latitude      Float?
  descripcion   String     @default("")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  proyecto      Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  submodulos    Submodulo[]
  remoteSupport ModuloRemoteSupport?
  deviceState   ModuloDeviceState?

  @@index([proyectoId, tipo, estado])
  @@map("modulos")
}

model Submodulo {
  id            String        @id @default(uuid(7)) @db.Uuid
  moduloId      String        @map("modulo_id") @db.Uuid
  /// Key the API uses for the sub-module: chosen by the client or generated.
  submoduloId   String        @map("submodulo_id")
  /// Keeps the order the admin defined.
  position      Int           @default(0)
  nombre        String
  tipo          SubmoduloTipo @default(OTHER)
  identificador String        @default("")
  ip            String        @default("")
  mac           String        @default("")
  ubicacion     String        @default("")
  longitude     Float?
  latitude      Float?
  descripcion   String        @default("")
  estado        Boolean       @default(true)

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@unique([moduloId, submoduloId])
  @@index([moduloId, position])
  @@map("submodulos")
}

model ModuloRemoteSupport {
  moduloId    String                @id @map("modulo_id") @db.Uuid
  provider    RemoteSupportProvider @default(MESHCENTRAL)
  enabled     Boolean               @default(false)
  deviceName  String                @default("") @map("device_name")
  deviceId    String                @default("") @map("device_id")
  groupId     String                @default("") @map("group_id")
  baseUrl     String                @default("") @map("base_url")
  supportUrl  String                @default("") @map("support_url")
  desktopUrl  String                @default("") @map("desktop_url")
  terminalUrl String                @default("") @map("terminal_url")
  linkedAt    DateTime?             @map("linked_at") @db.Timestamptz(3)
  updatedAt   DateTime?             @map("updated_at") @db.Timestamptz(3)

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@map("modulo_remote_support")
}

/// Mirror of the module's device state reported by OPERATIVO in each heartbeat.
/// Overwritten as a whole; binding details are kept as reported (jsonb).
model ModuloDeviceState {
  moduloId             String                 @id @map("modulo_id") @db.Uuid
  binding              Json?
  bindingRequests      Json                   @default("[]") @map("binding_requests")
  connectionAudit      Json?                  @map("connection_audit")
  fingerprint          String                 @default("")
  socketId             String                 @default("") @map("socket_id")
  ipAddress            String                 @default("") @map("ip_address")
  locationLabel        String                 @default("") @map("location_label")
  connectionStatus     DeviceConnectionStatus @default(PENDING) @map("connection_status")
  heartbeatStatus      DeviceHeartbeatStatus  @default(pending) @map("heartbeat_status")
  isConnected          Boolean                @default(false) @map("is_connected")
  isAuthorized         Boolean                @default(false) @map("is_authorized")
  connectedAt          DateTime?              @map("connected_at") @db.Timestamptz(3)
  lastHeartbeatAt      DateTime?              @map("last_heartbeat_at") @db.Timestamptz(3)
  lastDisconnectAt     DateTime?              @map("last_disconnect_at") @db.Timestamptz(3)
  message              String                 @default("")
  sourceInstallationId String                 @default("") @map("source_installation_id")
  syncedAt             DateTime               @map("synced_at") @db.Timestamptz(3)

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@map("modulo_device_states")
}

// ───────────────────────────── Pensions ─────────────────────────────

model Pension {
  id                 String    @id @default(uuid(7)) @db.Uuid
  proyectoId         String    @map("proyecto_id") @db.Uuid
  nombre             String
  precio             Decimal   @db.Decimal(12, 2)
  descripcion        String    @default("")
  estado             Boolean   @default(true)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?   @map("cancelled_by") @db.Uuid
  cancellationReason String    @default("") @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  proyecto    Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  cancelledBy Usuario?         @relation("PensionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  horarios    PensionHorario[]
  passes      PensionPass[]

  @@index([proyectoId, estado])
  @@map("pensiones")
}

/// Weekly validity window, one row per weekday (was Pension.validez[7]).
model PensionHorario {
  pensionId   String @map("pension_id") @db.Uuid
  /// 0..6, same numbering the API uses.
  weekDay     Int    @map("week_day") @db.SmallInt
  /// Minutes since midnight, 0..1439 (from [HH, MM]).
  fromMinutes Int    @map("from_minutes") @db.SmallInt
  toMinutes   Int    @map("to_minutes") @db.SmallInt

  pension Pension @relation(fields: [pensionId], references: [id], onDelete: Cascade)

  @@id([pensionId, weekDay])
  @@map("pension_horarios")
}

model PensionPass {
  id                 String    @id @default(uuid(7)) @db.Uuid
  pensionId          String    @map("pension_id") @db.Uuid
  /// Null while the pass is free inventory.
  usuarioId          String?   @map("usuario_id") @db.Uuid
  name               String
  idPass             String    @unique @map("id_pass")
  vigent             Boolean   @default(false)
  antiPassback       Boolean   @default(true) @map("anti_passback")
  /// Physical state owned by OPERATIVO; kept for compatibility, ADMINISTRATIVO does not change it.
  inParking          Boolean   @default(false) @map("in_parking")
  created            DateTime  @default(now()) @db.Timestamptz(3)
  /// Null = not contracted yet (was -1).
  validFrom          DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo            DateTime? @map("valid_to") @db.Timestamptz(3)
  estado             Boolean   @default(true)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?   @map("cancelled_by") @db.Uuid
  cancellationReason String    @default("") @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  pension     Pension                @relation(fields: [pensionId], references: [id], onDelete: Restrict)
  usuario     Usuario?               @relation("PensionPassUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  cancelledBy Usuario?               @relation("PensionPassCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  operations  PensionPassOperation[]

  /// A user holds at most one active pass per pension.
  @@unique([usuarioId, pensionId], map: "pension_passes_active_usuario_pension_key", where: raw("usuario_id IS NOT NULL AND estado"))
  /// Free inventory lookup when precontracting.
  @@index([pensionId], map: "pension_passes_available_idx", where: raw("usuario_id IS NULL AND estado"))
  @@index([usuarioId])
  @@map("pension_passes")
}

/// Idempotency log of paid operations on a pass (was PensionPass.financialOperations).
model PensionPassOperation {
  /// Idempotency-Key of the request, unique across all passes.
  key           String                   @id
  pensionPassId String                   @map("pension_pass_id") @db.Uuid
  type          PensionPassOperationType
  months        Int                      @default(0) @db.SmallInt
  validFrom     DateTime                 @map("valid_from") @db.Timestamptz(3)
  validTo       DateTime                 @map("valid_to") @db.Timestamptz(3)
  processedAt   DateTime                 @default(now()) @map("processed_at") @db.Timestamptz(3)

  pensionPass PensionPass @relation(fields: [pensionPassId], references: [id], onDelete: Cascade)

  @@index([pensionPassId, processedAt])
  @@map("pension_pass_operations")
}

// ───────────────────────────── Payments ─────────────────────────────

enum ExternalOrderStatus {
  quoted
  payment_pending
  paid
  confirmed
  confirmation_failed
  expired
  refunded

  @@map("external_order_status")
}

model ExternalPaymentOrder {
  id                    String              @id @default(uuid(7)) @db.Uuid
  /// Provider of the payment provider catalog (its id) that quoted and confirms the order.
  provider              String              @db.VarChar(64)
  reference             String              @db.VarChar(256)
  /// Parking (Viggo project) the user was in; kept for reports by parking.
  proyectoId            String?             @map("proyecto_id") @db.Uuid
  usuarioId             String              @map("usuario_id") @db.Uuid
  ticket                String
  parkingId             String              @map("parking_id")
  parkingName           String              @map("parking_name")
  amountMinor           Int                 @map("amount_minor")
  currency              String              @db.Char(3)
  expiresAt             DateTime            @map("expires_at") @db.Timestamptz(3)
  status                ExternalOrderStatus @default(quoted)
  stripePaymentIntentId String?             @unique @map("stripe_payment_intent_id")
  intentStartedAt       DateTime?           @map("intent_started_at") @db.Timestamptz(3)
  attempts              Int                 @default(0)
  nextRetryAt           DateTime            @default(now()) @map("next_retry_at") @db.Timestamptz(3)
  leaseOwner            String              @default("") @map("lease_owner")
  leaseUntil            DateTime?           @map("lease_until") @db.Timestamptz(3)
  confirmationReference String              @default("") @map("confirmation_reference")
  lastError             String              @default("") @map("last_error")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario  Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  proyecto Proyecto?              @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  events   ExternalPaymentEvent[]

  /// One live order per provider reference. An expired or refunded order frees the
  /// reference, so the same ticket can be quoted again (its fee may have changed).
  @@unique([provider, reference], map: "external_payment_orders_live_reference_key", where: raw("status <> 'expired' AND status <> 'refunded'"))
  @@index([status, nextRetryAt])
  @@index([usuarioId, createdAt(sort: Desc)])
  @@index([proyectoId, createdAt(sort: Desc)])
  @@map("external_payment_orders")
}

/// Append-only audit. Never stores raw QRs, client secrets or provider credentials.
model ExternalPaymentEvent {
  id        String               @id @default(uuid(7)) @db.Uuid
  orderId   String               @map("order_id") @db.Uuid
  kind      String
  detail    String               @default("")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  order     ExternalPaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("external_payment_events")
}

model Payment {
  id                    String               @id @default(uuid(7)) @db.Uuid
  usuarioId             String               @map("usuario_id") @db.Uuid
  type                  PaymentType
  concept               String
  amount                Decimal              @db.Decimal(12, 2)
  /// ISO 4217, uppercase.
  currency              String               @db.Char(3)
  status                PaymentStatus
  paidAt                DateTime             @map("paid_at") @db.Timestamptz(3)
  stripePaymentIntentId String?              @unique @map("stripe_payment_intent_id")
  idempotencyKey        String?              @unique @map("idempotency_key")
  appliedOperationKey   String               @default("") @map("applied_operation_key")
  appliedAt             DateTime?            @map("applied_at") @db.Timestamptz(3)
  reconciliationStatus  ReconciliationStatus @default(pending) @map("reconciliation_status")
  reconciledAt          DateTime?            @map("reconciled_at") @db.Timestamptz(3)
  reconciliationError   String               @default("") @map("reconciliation_error")
  metadata              Json?
  paymentMethodBrand    String               @default("") @map("payment_method_brand")
  paymentMethodLast4    String               @default("") @map("payment_method_last4") @db.VarChar(4)
  referenceType         PaymentType          @map("reference_type")
  /// Ticket id (from OPERATIVO) or pension pass id.
  referenceId           String               @map("reference_id")
  /// Parking snapshot at payment time; proyectoId keeps the link while the project exists.
  proyectoId            String?              @map("proyecto_id") @db.Uuid
  parkingName           String               @default("") @map("parking_name")
  parkingCity           String               @default("") @map("parking_city")
  rawProviderStatus     String               @default("") @map("raw_provider_status")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  proyecto Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, paidAt(sort: Desc)])
  @@index([referenceType, referenceId])
  /// Reconciliation worker scan.
  @@index([paidAt], map: "payments_unreconciled_idx", where: raw("stripe_payment_intent_id IS NOT NULL AND (status = 'pending' OR (status = 'succeeded' AND (reconciliation_status <> 'reconciled' OR applied_operation_key = '')))"))
  @@map("payments")
}

// ───────────────────── Sync with OPERATIVO installations ─────────────────────

/// A local OPERATIVO server linked (or asking to be linked) to a parking.
model LocalInstallation {
  id                           String             @id @default(uuid(7)) @db.Uuid
  /// Identifier generated by the OPERATIVO server.
  installationId               String             @unique @map("installation_id")
  proyectoId                   String             @map("proyecto_id") @db.Uuid
  localApiBaseUrl              String             @default("") @map("local_api_base_url")
  serverIp                     String             @default("") @map("server_ip")
  serverMac                    String             @default("") @map("server_mac")
  browserLongitude             Float?             @map("browser_longitude")
  browserLatitude              Float?             @map("browser_latitude")
  browserLocationAccuracy      Float?             @map("browser_location_accuracy")
  browserLocationCapturedAt    DateTime?          @map("browser_location_captured_at") @db.Timestamptz(3)
  status                       InstallationStatus @default(pending)
  /// User of the OPERATIVO server that asked for the link (not enforced as FK: it comes from another system).
  requestedByUserId            String             @default("") @map("requested_by_user_id")
  requestedByUserName          String             @default("") @map("requested_by_user_name")
  requestedAt                  DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedById                 String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedByUserName           String             @default("") @map("reviewed_by_user_name")
  reviewedAt                   DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNote                   String             @default("") @map("review_note")
  syncTokenHash                String             @default("") @map("sync_token_hash")
  syncTokenIssuedAt            DateTime?          @map("sync_token_issued_at") @db.Timestamptz(3)
  syncTokenDeliveredAt         DateTime?          @map("sync_token_delivered_at") @db.Timestamptz(3)
  /// Hash of the token replaced by the last rotation: still accepted until the new token is
  /// used once, so a lost rotation answer does not lock the installation out.
  previousSyncTokenHash        String             @default("") @map("previous_sync_token_hash")
  /// Set by an administrator; the installation is told to rotate on its next sync call.
  syncTokenRotationRequestedAt DateTime?          @map("sync_token_rotation_requested_at") @db.Timestamptz(3)
  /// Token ADMINISTRATIVO uses to call this installation's local API, derived from its sync
  /// token (HMAC) and stored encrypted. It cannot be used to impersonate the installation.
  adminCallTokenEncrypted      String             @default("") @map("admin_call_token_encrypted")
  lastCommandPollAt            DateTime?          @map("last_command_poll_at") @db.Timestamptz(3)
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  proyecto         Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  reviewedBy       Usuario?          @relation("InstallationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  mobileOperations MobileOperation[]

  @@index([proyectoId, status])
  @@index([status, lastCommandPollAt])
  /// Every sync request authenticates by this hash.
  @@index([syncTokenHash])
  @@map("local_installations")
}

/// Command queue from the mobile app to a parking's OPERATIVO server.
model MobileOperation {
  operationId          String                @id @map("operation_id") @db.Uuid
  idempotencyKey       String                @unique @map("idempotency_key")
  type                 MobileOperationType
  installationId       String                @map("installation_id")
  proyectoId           String                @map("proyecto_id") @db.Uuid
  usuarioId            String                @map("usuario_id") @db.Uuid
  payload              Json                  @default("{}")
  result               Json?
  /// result.ticket.uid, extracted on completion for lookups by ticket.
  ticketId             String?               @map("ticket_id")
  status               MobileOperationStatus @default(pending)
  error                String                @default("")
  attempts             Int                   @default(0)
  maxAttempts          Int                   @default(3) @map("max_attempts")
  nextRetryAt          DateTime?             @map("next_retry_at") @db.Timestamptz(3)
  claimedAt            DateTime?             @map("claimed_at") @db.Timestamptz(3)
  lastAttemptAt        DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  processingDeadlineAt DateTime?             @map("processing_deadline_at") @db.Timestamptz(3)
  completedAt          DateTime?             @map("completed_at") @db.Timestamptz(3)
  expiresAt            DateTime?             @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  installation LocalInstallation @relation(fields: [installationId], references: [installationId], onDelete: Restrict)
  proyecto     Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  usuario      Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  /// Claim queue: oldest due command of an installation (FOR UPDATE SKIP LOCKED).
  @@index([installationId, createdAt], map: "mobile_operations_claimable_idx", where: raw("status = ANY (ARRAY['pending'::mobile_operation_status, 'failed'::mobile_operation_status])"))
  @@index([installationId, status, updatedAt])
  @@index([usuarioId, completedAt(sort: Desc)])
  @@index([usuarioId, ticketId])
  @@index([status, updatedAt])
  @@map("mobile_operations")
}

/// Idempotent inbox of events pushed by OPERATIVO (offline-first outbox, #12).
model InboxEvent {
  /// Stable id generated by OPERATIVO; a retry with the same id is a duplicate.
  eventId         String    @id @map("event_id")
  installationId  String    @map("installation_id")
  proyectoId      String    @map("proyecto_id") @db.Uuid
  eventType       String    @map("event_type")
  aggregateId     String    @map("aggregate_id")
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz(3)
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  sourcePosition  BigInt?   @map("source_position")
  processingError String    @default("") @map("processing_error")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Restrict)

  @@index([proyectoId, occurredAt(sort: Desc)])
  @@index([receivedAt], map: "inbox_events_unprocessed_idx", where: raw("processed_at IS NULL"))
  @@map("inbox_events")
}

/// Latest heartbeat summary of each parking (one row per project, overwritten).
model ProjectHeartbeatSnapshot {
  proyectoId     String   @id @map("proyecto_id") @db.Uuid
  installationId String   @map("installation_id")
  source         String
  generatedAt    DateTime @map("generated_at") @db.Timestamptz(3)
  receivedAt     DateTime @map("received_at") @db.Timestamptz(3)
  summary        Json     @default("{}")
  modules        Json     @default("[]")
  metadata       Json?

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([receivedAt])
  @@map("project_heartbeat_snapshots")
}

model OperationalIncident {
  incidentKey    String           @id @map("incident_key")
  type           IncidentType
  status         IncidentStatus
  severity       IncidentSeverity
  source         String
  proyectoId     String?          @map("proyecto_id") @db.Uuid
  installationId String           @default("") @map("installation_id")
  operationId    String           @default("") @map("operation_id")
  paymentId      String           @default("") @map("payment_id")
  message        String
  metadata       Json?
  openedAt       DateTime         @map("opened_at") @db.Timestamptz(3)
  lastSeenAt     DateTime         @map("last_seen_at") @db.Timestamptz(3)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)

  proyecto Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt(sort: Desc)])
  @@index([type, status])
  @@index([proyectoId])
  @@map("operational_incidents")
}

/// Lease that lets only one API instance run a background job at a time.
/// Expires on its own, so a crashed instance never blocks the job.
model JobLease {
  name       String   @id
  owner      String
  acquiredAt DateTime @map("acquired_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("job_leases")
}

/// Read-only row snapshot owned by OPERATIVO; references stay in the payload so arrivals need no parent ordering.
model OperationalTicket {
  proyectoId     String   @map("proyecto_id") @db.Uuid
  installationId String   @map("installation_id")
  aggregateId    String   @map("aggregate_id")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  sourcePosition BigInt?  @map("source_position")
  eventId        String   @map("event_id")
  payload        Json
  proyecto       Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([proyectoId, installationId, aggregateId])
  @@index([proyectoId, occurredAt])
  @@map("operational_tickets")
}

